<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ReconW Report — {{ program_name }} (Run #{{ run.id }})</title>
<style>
  :root {
    --bg: #0a1420;
    --panel: #0f1e2e;
    --panel-hi: #162b42;
    --line: #20374f;
    --ink: #e9f2fa;
    --ink-dim: #8ba2ba;
    --ink-faint: #516a82;
    --cyan: #5fc9f3;
    --amber: #eda944;
    --green: #72d19c;
    --red: #ef6c68;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 0;
    background: var(--bg); color: var(--ink);
    font-family: var(--sans); font-size: 14.5px; line-height: 1.6;
    background-image:
      linear-gradient(rgba(95,201,243,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(95,201,243,0.03) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .container { max-width: 1140px; margin: 0 auto; padding: 32px 24px 60px; }
  header { border-bottom: 1px solid var(--line); padding-bottom: 24px; margin-bottom: 32px; }
  .brand { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; color: var(--cyan); text-transform: uppercase; margin-bottom: 6px; }
  .program-badge { display: inline-block; background: rgba(237,169,68,0.15); color: var(--amber); border: 1px solid rgba(237,169,68,0.35); font-family: var(--mono); font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 6px; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
  h1 { margin: 0 0 8px; font-size: 28px; font-weight: 800; }
  .meta-bar { display: flex; gap: 20px; flex-wrap: wrap; font-family: var(--mono); font-size: 12px; color: var(--ink-dim); margin-top: 10px; }
  .meta-bar span b { color: var(--ink); }
  
  /* Stats Cards Grid */
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 32px; }
  .stat-card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px 20px; position: relative; }
  .stat-card::before { content: ""; position: absolute; top: -1px; left: -1px; width: 8px; height: 8px; border-top: 2px solid var(--cyan); border-left: 2px solid var(--cyan); }
  .stat-val { font-family: var(--mono); font-size: 28px; font-weight: 700; color: var(--cyan); line-height: 1.1; margin-bottom: 4px; }
  .stat-val--red { color: var(--red); }
  .stat-val--amber { color: var(--amber); }
  .stat-val--green { color: var(--green); }
  .stat-label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-faint); font-family: var(--mono); }

  /* Sections */
  .sec { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 24px; margin-bottom: 28px; }
  .sec-title { font-family: var(--mono); font-size: 16px; font-weight: 700; color: var(--cyan); margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; }
  
  /* Controls / Toolbar */
  .toolbar { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
  .search-input { flex: 1; min-width: 240px; background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 8px 14px; color: var(--ink); font-family: var(--mono); font-size: 13px; }
  .search-input:focus { outline: 2px solid var(--cyan); }
  .select-ctrl { background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 8px 14px; color: var(--ink); font-family: var(--mono); font-size: 13px; cursor: pointer; }
  .btn-export { background: var(--panel-hi); border: 1px solid var(--cyan); color: var(--cyan); font-family: var(--mono); font-size: 12px; padding: 8px 16px; border-radius: 6px; cursor: pointer; text-transform: uppercase; font-weight: 600; }
  .btn-export:hover { background: var(--cyan); color: var(--bg); }

  /* Tables */
  .table-wrap { overflow-x: auto; }
  table.data-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  table.data-table th { background: var(--panel-hi); text-align: left; padding: 10px 14px; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-faint); border-bottom: 1px solid var(--line); }
  table.data-table td { padding: 12px 14px; border-bottom: 1px solid var(--line); color: var(--ink-dim); vertical-align: top; }
  table.data-table tr:hover { background: rgba(95,201,243,0.03); }
  
  /* Badges */
  .badge { display: inline-block; font-family: var(--mono); font-size: 10.5px; font-weight: 700; padding: 3px 8px; border-radius: 4px; text-transform: uppercase; }
  .badge--Critical { background: rgba(239,108,104,0.18); color: var(--red); border: 1px solid rgba(239,108,104,0.4); }
  .badge--High { background: rgba(237,169,68,0.18); color: var(--amber); border: 1px solid rgba(237,169,68,0.4); }
  .badge--Medium { background: rgba(95,201,243,0.18); color: var(--cyan); border: 1px solid rgba(95,201,243,0.4); }
  .badge--Low { background: rgba(114,209,156,0.18); color: var(--green); border: 1px solid rgba(114,209,156,0.4); }
  .badge--Info { background: rgba(81,106,130,0.2); color: var(--ink-dim); border: 1px solid var(--line); }
  
  /* Status Codes */
  .status-200 { color: var(--green); font-weight: 700; font-family: var(--mono); }
  .status-300 { color: var(--cyan); font-weight: 700; font-family: var(--mono); }
  .status-400 { color: var(--amber); font-weight: 700; font-family: var(--mono); }
  .status-500 { color: var(--red); font-weight: 700; font-family: var(--mono); }

  /* Chips */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { background: var(--bg); border: 1px solid var(--line); color: var(--ink-dim); font-family: var(--mono); font-size: 11px; padding: 2px 8px; border-radius: 4px; }
  
  /* Collapsible row */
  .breakdown-box { margin-top: 8px; padding: 10px 12px; background: var(--bg); border: 1px solid var(--line); border-radius: 6px; font-family: var(--mono); font-size: 11.5px; }
  
  footer { text-align: center; color: var(--ink-faint); font-family: var(--mono); font-size: 12px; margin-top: 40px; }
</style>
</head>
<body>

<div class="container">
  <header>
    <div class="brand">ReconW Orchestrator &bull; Security Reconnaissance</div>
    <div class="program-badge">Target Program: {{ program_name }}</div>
    <h1>Reconnaissance Findings</h1>
    <div class="meta-bar">
      <span>Run ID: <b>#{{ run.id }}</b></span>
      <span>Started: <b>{{ run.started_at }}</b></span>
      <span>Status: <b style="color:var(--green)">{{ run.status }}</b></span>
      <span>CLI Command: <code>{{ run.cli_args }}</code></span>
    </div>
  </header>

  <!-- Key Stats Cards -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-val">{{ assets|length }}</div>
      <div class="stat-label">Discovered Subdomains</div>
    </div>
    <div class="stat-card">
      <div class="stat-val stat-val--green">{{ endpoints|length }}</div>
      <div class="stat-label">Live HTTP Endpoints</div>
    </div>
    <div class="stat-card">
      <div class="stat-val stat-val--amber">{{ urls|length }}</div>
      <div class="stat-label">Crawled URLs / APIs</div>
    </div>
    <div class="stat-card">
      <div class="stat-val stat-val--red">{{ critical_count }}</div>
      <div class="stat-label">Critical Risk Targets</div>
    </div>
    <div class="stat-card">
      <div class="stat-val stat-val--amber">{{ high_count }}</div>
      <div class="stat-label">High Risk Targets</div>
    </div>
  </div>

  <!-- Prioritized Findings Table -->
  <div class="sec">
    <div class="sec-title">
      <span>Prioritized Security Targets</span>
      <span style="font-size:12px; color:var(--ink-dim);">{{ scores|length }} Target(s) Evaluated</span>
    </div>

    <div class="toolbar">
      <input type="text" id="targetSearch" class="search-input" placeholder="Search hosts, URLs, titles, technologies..." oninput="filterTargets()">
      <select id="bandFilter" class="select-ctrl" onchange="filterTargets()">
        <option value="ALL">All Severities</option>
        <option value="Critical">Critical Only</option>
        <option value="High">High Only</option>
        <option value="Medium">Medium Only</option>
        <option value="Low">Low Only</option>
        <option value="Info">Info Only</option>
      </select>
      <select id="sortFilter" class="select-ctrl" onchange="filterTargets()">
        <option value="score_desc">Sort: Highest Score</option>
        <option value="score_asc">Sort: Lowest Score</option>
        <option value="status">Sort: Status Code</option>
      </select>
      <button class="btn-export" onclick="exportDataBlob()">Export JSON</button>
    </div>

    <div class="table-wrap">
      <table class="data-table" id="findingsTable">
        <thead>
          <tr>
            <th style="width:100px;">Severity</th>
            <th style="width:70px;">Score</th>
            <th>Endpoint URL</th>
            <th style="width:80px;">Status</th>
            <th>Page Title</th>
            <th>Tech Stack</th>
          </tr>
        </thead>
        <tbody id="findingsBody">
          {% for s in scores %}
          <tr class="target-row" data-band="{{ s.band }}" data-score="{{ s.score }}" data-status="{{ s.status_code }}" data-search="{{ s.url }} {{ s.title }} {{ s.tech_stack_json }}">
            <td><span class="badge badge--{{ s.band }}">{{ s.band }}</span></td>
            <td><b style="font-family:var(--mono); color:var(--ink);">{{ s.score }}</b></td>
            <td>
              <a href="{{ s.url }}" target="_blank" rel="noopener" style="color:var(--cyan); font-family:var(--mono); word-break:break-all;">{{ s.url }}</a>
              {% if s.breakdown %}
              <div class="breakdown-box">
                <span style="color:var(--ink-faint)">Rules Triggered:</span>
                {% for rule, pts in s.breakdown.items() %}
                  <span style="color:var(--amber); margin-left:6px;">{{ rule }}: +{{ pts }}</span>
                {% endfor %}
              </div>
              {% endif %}
            </td>
            <td>
              {% if s.status_code == 200 %}
                <span class="status-200">200 OK</span>
              {% elif s.status_code in [301, 302, 307, 308] %}
                <span class="status-300">{{ s.status_code }}</span>
              {% elif s.status_code in [401, 403] %}
                <span class="status-400">{{ s.status_code }}</span>
              {% else %}
                <span class="status-500">{{ s.status_code }}</span>
              {% endif %}
            </td>
            <td style="color:var(--ink);">{{ s.title or "—" }}</td>
            <td>
              <div class="chips">
                {% for t in s.tech_list %}
                  <span class="chip">{{ t }}</span>
                {% else %}
                  <span style="color:var(--ink-faint); font-family:var(--mono); font-size:11px;">—</span>
                {% endfor %}
              </div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Tech Stack Breakdown -->
  <div class="sec">
    <div class="sec-title">Tech Stack Distribution</div>
    <div class="chips">
      {% for tech, count in tech_distribution.items() %}
        <span class="chip" style="color:var(--cyan); border-color:rgba(95,201,243,0.3); font-size:12px; padding:4px 10px;">{{ tech }} &times; {{ count }}</span>
      {% else %}
        <span style="color:var(--ink-dim)">No technology fingerprints detected.</span>
      {% endfor %}
    </div>
  </div>

  <!-- Crawled URLs (Katana) -->
  {% if urls %}
  <div class="sec">
    <div class="sec-title">Crawled Endpoints &amp; API Routes (Katana)</div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Discovered URL</th>
            <th style="width:180px;">Discovered At</th>
          </tr>
        </thead>
        <tbody>
          {% for u in urls[:50] %}
          <tr>
            <td><a href="{{ u.url }}" target="_blank" rel="noopener" style="color:var(--ink-dim); font-family:var(--mono); font-size:12.5px; word-break:break-all;">{{ u.url }}</a></td>
            <td style="font-family:var(--mono); font-size:11px;">{{ u.discovered_at }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% if urls|length > 50 %}
      <p style="font-size:12px; color:var(--ink-faint); margin-top:10px;">Showing first 50 of {{ urls|length }} crawled URLs. Export JSON for full list.</p>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <!-- Provenance & Tool Execution Log -->
  <div class="sec">
    <div class="sec-title">Audit Trail &amp; Tool Provenance</div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Stage</th>
            <th>Tool</th>
            <th>Exit Code</th>
            <th>Items Found</th>
            <th>Command Line</th>
          </tr>
        </thead>
        <tbody>
          {% for t in tool_results %}
          <tr>
            <td style="font-family:var(--mono); color:var(--cyan);">{{ t.stage_name }}</td>
            <td style="font-family:var(--mono); font-weight:700;">{{ t.tool_name }}</td>
            <td>
              {% if t.exit_code == 0 %}
                <span style="color:var(--green); font-family:var(--mono); font-weight:700;">0 (SUCCESS)</span>
              {% else %}
                <span style="color:var(--red); font-family:var(--mono); font-weight:700;">{{ t.exit_code }} (FAILED)</span>
              {% endif %}
            </td>
            <td style="font-family:var(--mono);">{{ t.item_count }}</td>
            <td><code style="color:var(--ink-faint); font-size:11px;">{{ t.command }}</code></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <footer>
    ReconW Pipeline Orchestrator &bull; Program: {{ program_name }} &bull; Run #{{ run.id }}
  </footer>
</div>

<script>
  // Embedded JSON Data Blob for Client-side Export
  const reportDataBlob = {{ json_blob|safe }};

  function filterTargets() {
    const query = document.getElementById('targetSearch').value.toLowerCase();
    const band = document.getElementById('bandFilter').value;
    const sort = document.getElementById('sortFilter').value;
    const tbody = document.getElementById('findingsBody');
    const rows = Array.from(tbody.querySelectorAll('.target-row'));

    rows.forEach(row => {
      const rowBand = row.getAttribute('data-band');
      const rowSearch = row.getAttribute('data-search').toLowerCase();

      const matchesSearch = !query || rowSearch.includes(query);
      const matchesBand = band === 'ALL' || rowBand === band;

      if (matchesSearch && matchesBand) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });

    // Sorting
    rows.sort((a, b) => {
      if (sort === 'score_desc') return parseInt(b.getAttribute('data-score')) - parseInt(a.getAttribute('data-score'));
      if (sort === 'score_asc') return parseInt(a.getAttribute('data-score')) - parseInt(b.getAttribute('data-score'));
      if (sort === 'status') return parseInt(a.getAttribute('data-status')) - parseInt(b.getAttribute('data-status'));
      return 0;
    });
    rows.forEach(r => tbody.appendChild(r));
  }

  function exportDataBlob() {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(reportDataBlob, null, 2));
    const dlAnchor = document.createElement('a');
    dlAnchor.setAttribute("href", dataStr);
    dlAnchor.setAttribute("download", "{{ program_name|lower|replace(' ', '_') }}_run_{{ run.id }}_export.json");
    document.body.appendChild(dlAnchor);
    dlAnchor.click();
    dlAnchor.remove();
  }
</script>
</body>
</html>
